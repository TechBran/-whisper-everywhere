<?xml version="1.0" encoding="utf-8"?>
<!--
  The transcript window's scrollbar THUMB — shared by the committed text and the live strip
  (owner ruling 2026-09-17: "I wanna see that there, and I wanna make sure that it's visible.
  That scrolling bar is very useful so people know that they can actually scroll previously").

  70% white on the dark panel, rounded so it reads as a bar and not a hairline. The framework's
  default thumb is a faint grey that fades out at rest, which is why earlier builds "don't seem to
  have" a scrollbar at all. Android still draws it only when the content exceeds the view; that is
  correct and stays.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#B3FFFFFF" />
    <corners android:radius="2dp" />
</shape>
