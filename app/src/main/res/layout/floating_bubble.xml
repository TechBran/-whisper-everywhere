<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="8dp">

    <!-- Transcription Preview Container -->
    <LinearLayout
        android:id="@+id/transcription_preview_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/preview_bubble_background"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <!-- Wrapper so the resize handle can OVERLAY the transcript's top-right corner: the
             container is a vertical LinearLayout, which can't stack children. The transcript
             view defines the panel width, so the wrapper's top-right is the panel's top-right. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- Read-only text for finalized transcription chunks. Width + height are
                 RUNTIME-OWNED (applyPreviewSize); 280dp is only the pre-first-apply default and
                 the height is set EXACTLY there (4.9.1) — not as a ceiling — so the panel is the
                 chosen size whether or not the text fills it. wrap_content here is the
                 pre-first-apply state only.

                 The scrollbar is PERSISTENT and VISIBLE (owner ruling 2026-09-17, the 96 tablet
                 session: "that scrolling bar is very useful so people know that they can
                 actually scroll previously") — and since 4.9.1 it is the TranscriptScrubberView
                 beside this text, not the framework's: "if we touch the slider, we should be
                 able to slide it up and down". The framework bar is a drawing that takes no
                 touches, so this view's own scrollbars are NONE and the scrubber is the one bar
                 (same 4dp, same thumb-on-track colours). Pinned by BubbleScrollbarPinTest. -->
            <TextView
                android:id="@+id/transcription_edit_text"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:hint="Listening..."
                android:textColorHint="#99FFFFFF"
                android:gravity="top|start" />

            <!-- The committed text's grabbable scrollbar (4.9.1): a 12dp touch lane on the
                 panel's right edge, drawing the 4dp bar at its edge, starting BELOW the resize
                 handle so the handle keeps its corner. INVISIBLE (no touches) when the text
                 fits; the view decides that itself from the TextView it is bound to. -->
            <com.whispereverywhere.ui.components.TranscriptScrubberView
                android:id="@+id/transcript_scrubber"
                android:layout_width="12dp"
                android:layout_height="match_parent"
                android:layout_gravity="top|end"
                android:layout_marginTop="28dp"
                android:visibility="invisible" />

            <!-- W3 resize handle: 28dp touch target, 45-degree double-arrow, visible whenever
                 the container is (resizing mid-dictation is the intended flow). Drag = resize,
                 long-press = reset to 280x120dp. It consumes its own gesture — child-first
                 dispatch beats the root drag listener and its long-press-to-pin arming.
                 RED at full alpha (owner ruling 2026-09-17: "a color where we can actually see
                 it. I say red") — the drawable carries the colour; see ic_resize_handle.xml. -->
            <ImageView
                android:id="@+id/resize_handle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:padding="6dp"
                android:alpha="1.0"
                android:src="@drawable/ic_resize_handle"
                android:contentDescription="Resize transcript window" />
        </FrameLayout>

        <!--
          Live delta text — the word-for-word preview.

          Scrolls rather than truncating, and grows to ~5 lines before it does: a live turn is a
          whole spoken utterance, and clipping it to one line was the owner-reported polish gap
          (2026-07-31) — the panel showed "a word or two" while the words kept coming. maxLines
          bounds the overlay so a long turn can never grow it off-screen; the scroll (driven from
          the service) keeps the newest words visible. Rendering only — deltas are NEVER injected;
          the accessibility layer has no composing-text API, so writing live text into an app's
          field would mean rewriting the whole field several times a second, which is the exact
          corruption class Release A's ordering exists to prevent (spec 5.6a/5.6b).

          The scrollbar is the SAME grabbable bar the committed text carries above (owner ruling
          2026-09-17; the 4.4 previewer panel's framework bar was "barely visible" and, like any
          framework bar, took no touches): a TranscriptScrubberView beside the strip in the same
          FrameLayout wrapper, this view's own scrollbars NONE. The strip KEEPS its 4dp top
          margin (the scrubber carries the same, so it spans the text exactly): on the wrapper it
          would survive a GONE strip as 4dp of phantom panel. The service still writes to the
          TextView by id and the strip's own visibility (GONE / INVISIBLE / VISIBLE) still drives
          the window's height — an INVISIBLE strip occupies its height in the wrapper exactly as
          it did in the container, a GONE one collapses the wrapper to nothing. Pinned by
          BubbleScrollbarPinTest.
        -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/transcription_delta_text"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="5"
                android:scrollbars="none"
                android:lineSpacingExtra="2dp"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp"
                android:textStyle="italic"
                android:visibility="gone" />

            <com.whispereverywhere.ui.components.TranscriptScrubberView
                android:id="@+id/delta_scrubber"
                android:layout_width="12dp"
                android:layout_height="match_parent"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:visibility="invisible" />

        </FrameLayout>

    </LinearLayout>

    <!-- Mic Bubble Stack -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- Living blob body: audio-reactive shape replacing the static circle background.
             56dp body + 12dp ripple headroom per side. -->
        <com.whispereverywhere.ui.components.BlobView
            android:id="@+id/blob_view"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center" />

        <ImageView
            android:id="@+id/processing_ring"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_processing_ring"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/bubble_container"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@null">

            <ImageView
                android:id="@+id/bubble_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic" />

            <!-- Spans the FULL pill: the wave's envelope is computed from the pill's own cap
                 geometry, so the ribbon tips terminate exactly on the bubble edge. -->
            <com.whispereverywhere.ui.components.BarWaveformView
                android:id="@+id/waveform_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Live recording timer (design ref: red dot + mm:ss, bottom-left in the pill). -->
            <TextView
                android:id="@+id/recording_timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="18dp"
                android:layout_marginBottom="5dp"
                android:fontFamily="monospace"
                android:textColor="#E6FFFFFF"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/processing_time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Drag-to-seek line for TTS playback: thin, lives inside the pill under the
                 waveform (user design 2026-07-18). Touch height is generous; the drawn line
                 stays hairline. -->
            <com.whispereverywhere.ui.components.TtsScrubberView
                android:id="@+id/tts_scrubber"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="40dp"
                android:visibility="gone" />

            <!-- Read-aloud stop control: visible only while speech plays. Generous padded tap
                 target (user feedback: the old 20dp corner button was hard to hit). -->
            <ImageView
                android:id="@+id/speech_stop_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="2dp"
                android:src="@drawable/ic_stop_speech"
                android:tint="#FF6B62"
                android:visibility="gone"
                android:contentDescription="Stop reading" />

        </FrameLayout>

        <!-- Satellite lobes (user design 2026-07-18): the lock and speaker are their OWN
             portions of the blob — same fill color, overlapping the body inside its ripple
             headroom so they fuse into one organism. Lock extends right, speaker bottom-left.
             Both are idle-only; the pill hides them. Drawn last = on top of the body. -->
        <!-- Corner layout (owner 2026-08-01): lock top-right, speaker bottom-left — one corner
             each, every lobe pulled AWAY from the mic so each has a clean hitbox and a mistap
             hits nothing instead of the wrong control. (The bottom-right keyboard lobe went with
             the dictation-first keyboard feature, owner ruling 2026-09-17.) -->
        <FrameLayout
            android:id="@+id/lock_lobe"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end|top"
            android:background="@drawable/lobe_circle"
            android:elevation="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/pin_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock_open"
                android:contentDescription="Lock bubble position" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/speaker_lobe"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="start|bottom"
            android:background="@drawable/lobe_circle"
            android:elevation="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/speak_clip_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_speaker"
                android:tint="#4FC3F7"
                android:contentDescription="Read clipboard aloud" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
