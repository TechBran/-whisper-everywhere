<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="8dp">

    <!-- Transcription Preview Container -->
    <LinearLayout
        android:id="@+id/transcription_preview_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/preview_bubble_background"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <!-- Read-only text for finalized transcription chunks -->
        <TextView
            android:id="@+id/transcription_edit_text"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:maxHeight="120dp"
            android:scrollbars="vertical"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:minHeight="20dp"
            android:hint="Listening..."
            android:textColorHint="#99FFFFFF"
            android:gravity="top|start" />

        <!-- Live delta text -->
        <TextView
            android:id="@+id/transcription_delta_text"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Mic Bubble Stack -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- Living blob body: audio-reactive shape replacing the static circle background.
             56dp body + 12dp ripple headroom per side. -->
        <com.whispereverywhere.ui.components.BlobView
            android:id="@+id/blob_view"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center" />

        <ImageView
            android:id="@+id/processing_ring"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_processing_ring"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/bubble_container"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@null">

            <ImageView
                android:id="@+id/bubble_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic" />

            <!-- Spans the FULL pill: the wave's envelope is computed from the pill's own cap
                 geometry, so the ribbon tips terminate exactly on the bubble edge. -->
            <com.whispereverywhere.ui.components.BarWaveformView
                android:id="@+id/waveform_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Live recording timer (design ref: red dot + mm:ss, bottom-left in the pill). -->
            <TextView
                android:id="@+id/recording_timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="18dp"
                android:layout_marginBottom="5dp"
                android:fontFamily="monospace"
                android:textColor="#E6FFFFFF"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/processing_time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Read-aloud stop control: visible only while speech plays. Generous padded tap
                 target (user feedback: the old 20dp corner button was hard to hit). -->
            <ImageView
                android:id="@+id/speech_stop_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="2dp"
                android:src="@drawable/ic_stop_speech"
                android:tint="#FF6B62"
                android:visibility="gone"
                android:contentDescription="Stop reading" />

        </FrameLayout>

        <!-- Satellite lobes (user design 2026-07-18): the lock and speaker are their OWN
             portions of the blob — same fill color, overlapping the body inside its ripple
             headroom so they fuse into one organism. Lock extends right, speaker bottom-left.
             Both are idle-only; the pill hides them. Drawn last = on top of the body. -->
        <FrameLayout
            android:id="@+id/lock_lobe"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/lobe_circle"
            android:elevation="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/pin_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock_open"
                android:contentDescription="Lock bubble position" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/speaker_lobe"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="start|bottom"
            android:background="@drawable/lobe_circle"
            android:elevation="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/speak_clip_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_speaker"
                android:tint="#4FC3F7"
                android:contentDescription="Read clipboard aloud" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
